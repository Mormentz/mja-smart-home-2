generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  AGENT
  ARTISAN
  ADMIN
}

enum KycLevel {
  BASIC
  STANDARD
  ENHANCED
}

enum PropertyType {
  FOR_SALE
  FOR_RENT
}

enum PropertyCategory {
  HOUSE
  APARTMENT
  VILLA
  LOFT
  TOWNHOUSE
  PENTHOUSE
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum BookingStatus {
  PENDING
  APPROVED
  CANCELLED
}

enum BookingKind {
  TOUR
  PURCHASE_INTEREST
}

enum SkillBadge {
  NONE
  BRONZE
  SILVER
  GOLD
}

enum LeaseStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum EscrowStatus {
  HELD
  RELEASED
  REFUNDED
}

enum EscrowPurpose {
  RENT
  ARTISAN
  MOVE_IN
}

enum JobUrgency {
  NORMAL
  EMERGENCY
}

enum JobStatus {
  REQUESTED
  QUOTED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum MoveInStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

model User {
  id            String              @id @default(cuid())
  name          String?
  email         String              @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          Role                @default(USER)
  active        Boolean             @default(true)
  phone         String?
  kycLevel      KycLevel            @default(BASIC)
  kycStatus     VerificationStatus  @default(UNVERIFIED)
  kycNote       String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  accounts           Account[]
  sessions           Session[]
  properties         Property[]      @relation("PropertyOwner")
  bookings           Booking[]
  sentMessages       Message[]       @relation("SentMessages")
  receivedMessages   Message[]       @relation("ReceivedMessages")
  serviceProfile     ServiceProfile?
  leasesAsRenter     Lease[]         @relation("LeaseRenter")
  leasesAsLandlord   Lease[]         @relation("LeaseLandlord")
  escrowPayments     EscrowPayment[] @relation("EscrowPayer")
  jobsAsCustomer     ServiceJob[]    @relation("JobCustomer")
  jobsAsArtisan      ServiceJob[]    @relation("JobArtisan")
  reviewsAuthored    Review[]        @relation("ReviewAuthor")
  reviewsReceived    Review[]        @relation("ReviewTarget")
  savedProperties    SavedProperty[]
  moveInRequests     MoveInRequest[]
}

model SiteContent {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Neighborhood {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  safety        Int
  power         Int
  water         Int
  affordability Int
  summary       String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  properties Property[]
}

model Property {
  id                 String             @id
  title              String
  location           String
  price              Int
  currency           String             @default("$")
  type               PropertyType
  category           PropertyCategory
  beds               Int
  baths              Int
  area               Int
  image              String
  images             String[]           @default([])
  featured           Boolean            @default(false)
  description        String             @db.Text
  amenities          String[]
  ownerId            String
  verificationStatus VerificationStatus @default(UNVERIFIED)
  verifiedAt         DateTime?
  tourUrl            String?
  neighborhoodId     String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  owner         User            @relation("PropertyOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  neighborhood  Neighborhood?   @relation(fields: [neighborhoodId], references: [id], onDelete: SetNull)
  propertyAmenities PropertyAmenity[]
  bookings      Booking[]
  messages      Message[]
  leases        Lease[]
  serviceJobs   ServiceJob[]
  reviews       Review[]
  savedBy       SavedProperty[]
  moveInRequests MoveInRequest[]
}

model Amenity {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  properties PropertyAmenity[]
}

model PropertyAmenity {
  propertyId String
  amenityId  String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amenity    Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([propertyId, amenityId])
}

model Booking {
  id            String        @id @default(cuid())
  propertyId    String
  userId        String
  preferredDate DateTime
  kind          BookingKind   @default(TOUR)
  status        BookingStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([propertyId])
}

model Message {
  id          String    @id @default(cuid())
  senderId    String
  recipientId String
  propertyId  String?
  content     String    @db.Text
  attachments Json      @default("[]")
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  sender    User      @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User      @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: Cascade)
  property  Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@index([senderId])
  @@index([recipientId])
}

model ServiceProfile {
  id               String             @id @default(cuid())
  userId           String             @unique
  trade            String
  bio              String             @db.Text
  verified         Boolean            @default(false)
  verificationStatus VerificationStatus @default(UNVERIFIED)
  skillBadge       SkillBadge         @default(NONE)
  available        Boolean            @default(true)
  hourlyRate       Int                @default(50)
  serviceArea      String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Lease {
  id          String      @id @default(cuid())
  propertyId  String
  renterId    String
  landlordId  String
  startDate   DateTime
  endDate     DateTime
  monthlyRent Int
  status      LeaseStatus @default(DRAFT)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  property       Property         @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  renter         User             @relation("LeaseRenter", fields: [renterId], references: [id], onDelete: Cascade)
  landlord       User             @relation("LeaseLandlord", fields: [landlordId], references: [id], onDelete: Cascade)
  escrowPayments EscrowPayment[]
  moveInRequests MoveInRequest[]

  @@index([renterId])
  @@index([landlordId])
  @@index([propertyId])
}

model EscrowPayment {
  id           String        @id @default(cuid())
  amount       Int
  status       EscrowStatus  @default(HELD)
  purpose      EscrowPurpose
  payerId      String
  leaseId      String?
  serviceJobId String?
  note         String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  releasedAt   DateTime?
  refundedAt   DateTime?

  payer      User        @relation("EscrowPayer", fields: [payerId], references: [id], onDelete: Cascade)
  lease      Lease?      @relation(fields: [leaseId], references: [id], onDelete: SetNull)
  serviceJob ServiceJob? @relation(fields: [serviceJobId], references: [id], onDelete: SetNull)

  @@index([payerId])
  @@index([leaseId])
  @@index([serviceJobId])
}

model ServiceJob {
  id            String     @id @default(cuid())
  customerId    String
  artisanId     String
  propertyId    String?
  description   String     @db.Text
  urgency       JobUrgency @default(NORMAL)
  status        JobStatus  @default(REQUESTED)
  priceEstimate Int?
  etaMinutes    Int?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  completedAt   DateTime?

  customer       User            @relation("JobCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  artisan        User            @relation("JobArtisan", fields: [artisanId], references: [id], onDelete: Cascade)
  property       Property?       @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  escrowPayments EscrowPayment[]
  reviews        Review[]

  @@index([customerId])
  @@index([artisanId])
}

model Review {
  id           String   @id @default(cuid())
  authorId     String
  targetUserId String?
  propertyId   String?
  serviceJobId String?
  rating       Int
  comment      String   @db.Text
  createdAt    DateTime @default(now())

  author     User        @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  targetUser User?       @relation("ReviewTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  property   Property?   @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  serviceJob ServiceJob? @relation(fields: [serviceJobId], references: [id], onDelete: SetNull)

  @@index([authorId])
  @@index([targetUserId])
  @@index([propertyId])
}

model SavedProperty {
  id         String   @id @default(cuid())
  userId     String
  propertyId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@index([userId])
}

model MoveInRequest {
  id          String       @id @default(cuid())
  userId      String
  propertyId  String
  leaseId     String?
  moving      Boolean      @default(false)
  furnishing  Boolean      @default(false)
  utilities   Boolean      @default(false)
  status      MoveInStatus @default(OPEN)
  notes       String?      @db.Text
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  lease    Lease?   @relation(fields: [leaseId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([propertyId])
}

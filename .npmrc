# Auth.js 5.0.0-beta.32 (latest) optionally peers nodemailer ^7.0.7 || ^8.0.5.
# This app sends mail with nodemailer 10 and does not use the Auth.js email provider.
# Nodemailer 8.0.11 is the newest version inside that peer range and is still
# inside GHSA-p6gq-j5cr-w38f (fixed in 9.0.1+).
legacy-peer-deps=true
